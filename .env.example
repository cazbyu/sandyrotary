# Supabase — VITE_ prefix exposes to frontend bundle
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase — NO VITE_ prefix, server-side only (Netlify functions)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_NEVER_COMMIT

# GoHighLevel OAuth 2.0 — server-side only
GHL_CLIENT_ID=your_ghl_client_id
GHL_CLIENT_SECRET=your_ghl_client_secret_NEVER_COMMIT
GHL_REDIRECT_URI=https://your-netlify-domain/.netlify/functions/ghl-callback
GHL_DEFAULT_LOCATION_ID=your_sandy_rotary_location_id
